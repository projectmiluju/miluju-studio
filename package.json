{
  "name": "miluju-studio",
  "version": "0.1.1",
  "type": "module",
  "description": "1인 개발자를 위한 AI 에이전트 워크플로우 OS",
  "homepage": "https://github.com/projectmiluju/miluju-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/projectmiluju/miluju-studio.git"
  },
  "license": "MIT",
  "bin": {
    "miluju-studio": "./bin/miluju.ts",
    "miluju": "./bin/miluju.ts"
  },
  "files": [
    "bin/",
    "src/issue-templates/",
    "dist/skills/",
    "dist/browse/",
    "skills/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun",
    "build:browse-node": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "gen": "bun run src/gen-skill-docs.ts",
    "browse": "bun run browse/server.ts",
    "eval": "bun run test/eval.ts",
    "miluju": "bun run bin/miluju.ts",
    "setup": "./setup",
    "prepublishOnly": "bun run gen && bun run build:browse-node && bun run typecheck"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@playwright/mcp": "^0.0.68",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.7.0"
  }
}
